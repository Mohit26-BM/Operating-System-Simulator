# Copy to .env.local. Server-side only: this key must NEVER start with VITE_ (Vite would publish it in the browser bundle).
# Everything except the "Explain this step" panel works without it.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional
# GROQ_MODEL=openai/gpt-oss-120b
# EXPLAIN_RATE_PER_MIN=12
# EXPLAIN_GLOBAL_PER_MIN=120
# Number of reverse proxies in front of the app (Vercel = 1). 0 = ignore X-Forwarded-For.
# TRUSTED_PROXY_HOPS=1
